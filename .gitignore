# Binaries
/bin/
/dist/
/membrane
*.exe
*.test
*.out

# Coverage
coverage.out
coverage.html
cover.out

# Go workspace / env
go.work
go.work.sum

# Secrets must never be committed. These patterns are a backstop; the config
# loader also rejects inline secrets.
*.pem
*.key
.env
.env.*
!.env.example
# Ignore secret *data* files (secrets.yaml / secrets.json / secrets.env, etc.)
# but never the legitimate Go source files named secrets.go.
secrets.*
!secrets.go
!**/secrets.go

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# SBOM / release artifacts
/sbom/
*.sbom.json
*.cdx.json

# Website (separate Next.js project; not part of the Membrane release)
/website/node_modules/
/website/.next/
/website/out/
