# Keep the Membrane release image clean and the build context small.
# Local build artifacts (never needed in the image).
bin/
dist/
# The embedded Membrane Console UI (go:embed) has to stay in the build
# context, even though it lives under a dist/ directory.
!internal/server/console/webui/dist
!internal/server/console/webui/dist/**
coverage.out
coverage.html
cover.out
*.cdx.json
sbom/
